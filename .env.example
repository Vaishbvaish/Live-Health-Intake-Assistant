# GEMINI_API_KEY (required)
# Server-side only. Used to mint short-lived Live API tokens and to synthesize
# the SOAP note. It is never sent to the browser.
# On Vercel, set this under Settings -> Environment Variables instead.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_VAD_SILENCE_MS (optional, default 900)
# Silence in milliseconds before the assistant decides the patient has
# finished speaking. Lower = snappier replies; too low and it talks over a
# patient who only paused mid-sentence. 700-1200 is the useful range.
GEMINI_VAD_SILENCE_MS="900"

# GEMINI_LIVE_MODEL / GEMINI_TEXT_MODEL (optional)
# Override the models. Defaults are the free-tier models named in the brief.
# GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
# GEMINI_TEXT_MODEL="gemini-3-flash-preview"
